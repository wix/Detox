{
  "name": "detox",
  "description": "E2E tests and automation for mobile",
  "version": "21.0.0-alpha.1",
  "bin": "local-cli/cli.js",
  "files": [
    "android",
    "detox-native",
    "Detox-android",
    "Detox-ios-*.tbz",
    "dist",
    "local-cli",
    "runners",
    "scripts",
    "src",
    "*.js",
    "*.json",
    "*.d.ts",
    "!**/__*__/**",
    "!**/*.mock.json",
    "!**/*.test.js",
    "!**/*.test.ts",
    "!**/*.snap",
    "!**/*.map",
    "dist/index.js.map",
    "dist/client.js.map",
    "dist/runners/jest/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wix/Detox.git"
  },
  "nativePackage": true,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/wix/Detox/issues"
  },
  "homepage": "https://github.com/wix/Detox#readme",
  "main": "./index.js",
  "types": "./index.d.ts",
  "author": "Tal Kol <talkol@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "cd .. && yarn build && yarn build:types",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build && node scripts/check_ios_framework.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@detox-remote/core": "workspace:*",
    "@detox-remote/protocol": "workspace:*",
    "react-native": "0.85.2",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "jest": "30.x.x || 29.x.x || 28.x.x || ^27.2.5"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
